<!-- Foreground layer for the adaptive icon, generated by the assistant -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Using a group to scale and center the icon within the safe zone -->
    <group
        android:translateX="-2.5"
        android:translateY="-2.5"
        android:pivotX="50"
        android:pivotY="50"
        android:scaleX="0.95"
        android:scaleY="0.95">

        <!-- Calendar Body (based on the main logo's background shape) -->
        <path
            android:pathData="M20,15 L80,15 A10,10 0 0 1 90,25 L90,85 A10,10 0 0 1 80,95 L20,95 A10,10 0 0 1 10,85 L10,25 A10,10 0 0 1 20,15 Z"
            android:fillColor="#EADDFF"/> <!-- Light color for foreground -->

        <!-- Calendar Top Bar -->
        <path
            android:pathData="M10,25 L90,25 L90,35 L10,35 Z"
            android:fillColor="#4F378B"/>

        <!-- Calendar Rings -->
        <path
            android:pathData="M25,10 L30,10 L30,22 L25,22 Z M70,10 L75,10 L75,22 L70,22 Z"
            android:fillColor="#FFFFFF"/>

        <!-- Clock Circle Overlay -->
        <path
            android:pathData="M65,65 m-22,0 a22,22 0 1,1 44,0 a22,22 0 1,1 -44,0"
            android:fillColor="#FFFFFF"/>
        
        <path
            android:pathData="M65,65 m-18,0 a18,18 0 1,1 36,0 a18,18 0 1,1 -36,0"
            android:fillColor="#D0BCFF"/>

        <!-- Clock Hands -->
        <path
            android:pathData="M65,65 L65,55 M65,65 L75,65"
            android:strokeColor="#6750A4"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"/>

        <!-- Schedule Grid Dots -->
        <path
            android:pathData="M25,45h5v5h-5z M40,45h5v5h-5z M25,60h5v5h-5z M40,60h5v5h-5z M25,75h5v5h-5z"
            android:fillColor="#6750A4"/>
    </group>
</vector>
