<?xml version="1.0" encoding="utf-8"?>
<!-- In-app icon: combines the launcher background + the new foreground WebP.
     Use this (R.drawable.ic_in_app_icon) wherever the logo is shown inside
     the app (SplashScreen, HomeScreen). Do NOT use R.mipmap.ic_launcher
     directly in Compose — adaptive icon XML is not renderable by painterResource. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background"/>
    <item android:drawable="@mipmap/ic_launcher_foreground"/>
</layer-list>
